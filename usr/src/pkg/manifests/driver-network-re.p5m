#
# Realtek RTL8125/RTL8126/RTL8127 Ethernet Driver
#

<include global_zone_only_component>
set name=pkg.fmri value=pkg:/driver/network/re@$(PKGVERS)
set name=pkg.summary value="Realtek RTL8125/8126/8127 Ethernet Driver"
set name=pkg.description value="Realtek RTL8125/8126/8127 Ethernet Driver"
set name=info.classification \
    value=org.opensolaris.category.2008:Drivers/Networking
dir  path=kernel group=sys
dir  path=kernel/drv group=sys
dir  path=kernel/drv/$(ARCH64) group=sys
file path=kernel/drv/$(ARCH64)/re group=sys
dir  path=usr/share/man
dir  path=usr/share/man/man4d
file path=usr/share/man/man4d/re.4d
driver name=re \
    alias=pciex10ec,8125 \
    alias=pciex10ec,8126 \
    alias=pciex10ec,8127
license lic_CDDL license=lic_CDDL
license usr/src/uts/common/io/re/core/THIRDPARTYLICENSE \
    license=usr/src/uts/common/io/re/core/THIRDPARTYLICENSE
